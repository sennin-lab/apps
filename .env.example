# 公開URL（仙人アカウントに登録するリダイレクトURIのベース。https必須）
PUBLIC_URL=https://your-store.example.com
# セッション署名用の長いランダム文字列（例: openssl rand -hex 32）
SESSION_SECRET=

# 仙人アカウント
SENNIN_BASE=https://sennin-account-api.xianrendesu.workers.dev
SENNIN_CLIENT_ID=sa_
SENNIN_CLIENT_SECRET=sas_
SENNIN_SCOPES=profile email points:read points:write
# 管理者の sub（カンマ区切り）。studio にログインすると表示されるIDを設定
ADMIN_SUBS=

# Supabase（サーバー用 service_role のみ。ブラウザには出さない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Turso（画像保存）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
