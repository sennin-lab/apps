# ===== Supabase =====
# Project Settings → API からコピー
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# anon public キー（フロントに渡してもよい）
SUPABASE_ANON_KEY=
# service_role キー（サーバーのみ。絶対に公開しない）
SUPABASE_SERVICE_ROLE_KEY=

# ===== Turso（画像の保存先） =====
# turso db show store --url で取得
TURSO_DATABASE_URL=libsql://store-yourname.turso.io
# turso db tokens create store で取得
TURSO_AUTH_TOKEN=

# ===== サーバー =====
# Render / Railway では自動設定されるので通常は不要
PORT=3000
