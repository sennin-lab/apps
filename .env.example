# 公開URL（仙人アカウントに登録するリダイレクトURIのベース。https必須）
PUBLIC_URL=https://your-store.example.com
# セッション署名用の長いランダム文字列（例: openssl rand -hex 32）
SESSION_SECRET=
# 仙人アカウントの更新トークンを暗号化する鍵（64桁の16進数。例: openssl rand -hex 32）
# ※鍵を変えると、保存済みの連携は読めなくなります（利用者はもう一度ログインします）
TOKEN_ENCRYPTION_KEY=

# 仙人アカウント
SENNIN_BASE=https://sennin-account-api.xianrendesu.workers.dev
# 認証画面のURL（Apps Script のURLなど）。未設定なら SENNIN_BASE + /oauth/authorize
SENNIN_AUTHORIZE_URL=
SENNIN_CLIENT_ID=sa_
SENNIN_CLIENT_SECRET=sas_
SENNIN_SCOPES=profile email points:read points:write
# 管理者の sub（カンマ区切り）。studio にログインすると表示されるIDを設定
ADMIN_SUBS=
# 運営のアカウントの sub（自分のアプリへの支払い・購入の売上の受け取り先）。未設定だと、自分のアプリは有料にできない
OPERATOR_SUB=

# Supabase（サーバー用 service_role のみ。ブラウザには出さない）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Turso（画像保存）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
